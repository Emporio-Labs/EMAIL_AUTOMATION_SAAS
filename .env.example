NODE_ENV=development
PORT=3000
AUTH_BYPASS=false

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# AWS — IAM user needs: ses:VerifyDomainDkim, ses:GetIdentityVerificationAttributes,
#         ses:GetIdentityDkimAttributes, ses:SendRawEmail, sqs:SendMessage
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key

# SQS
SQS_QUEUE_URL=https://sqs.ap-south-1.amazonaws.com/<account-id>/<queue-name>
SOURCE_QUEUE_URL=https://sqs.ap-south-1.amazonaws.com/<account-id>/<queue-name>
DEAD_LETTER_QUEUE_URL=https://sqs.ap-south-1.amazonaws.com/<account-id>/<queue-name>-dlq

# Shared secret used by the email worker to update job status
INTERNAL_KEY=replace-with-at-least-32-random-chars

# Platform settings
PLATFORM_FROM_EMAIL=noreply@swayamail.in
PLATFORM_FROM_NAME=SwayamMail
BASE_URL=http://localhost:3000

# SES configuration set with SNS event publishing (bounce, complaint, delivery)
SES_CONFIGURATION_SET=email-config

# Run the domain poller and HTML purge in this process (true on EC2)
RUN_BACKGROUND_JOBS=true
