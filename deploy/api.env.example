NODE_ENV=production
PORT=3000
AUTH_BYPASS=false

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# AWS — IAM user needs: ses:VerifyDomainDkim, ses:GetIdentityVerificationAttributes,
#         ses:GetIdentityDkimAttributes, ses:SendRawEmail, sqs:SendMessage
AWS_REGION=ap-south-1
# No AWS keys here: attach an IAM instance role to the EC2 host instead.

# SQS
SQS_QUEUE_URL=https://sqs.ap-south-1.amazonaws.com/<account-id>/<queue-name>

# Shared secret used by the email worker to update job status
INTERNAL_KEY=replace-with-at-least-32-random-chars

# Platform settings
PLATFORM_FROM_EMAIL=noreply@swayamail.in
PLATFORM_FROM_NAME=SwayamMail
BASE_URL=https://api.swayamail.in

# SES configuration set with SNS event publishing (bounce, complaint, delivery)
SES_CONFIGURATION_SET=email-config

# Run the domain poller and HTML purge in this process (true on EC2)
RUN_BACKGROUND_JOBS=true

# Email OTP (/v1/otp). All optional.
# Queue polled by the worker's priority pool (set PRIORITY_QUEUE_URL there too).
OTP_SQS_QUEUE_URL=https://sqs.ap-south-1.amazonaws.com/<account-id>/otp-jobs
# Separate domain for default senders: noreply@<customer>.<OTP_SENDING_DOMAIN>.
# Never the main brand domain. Leave empty until you have bought one.
OTP_SENDING_DOMAIN=
# Route 53 zone of OTP_SENDING_DOMAIN: gives each customer its own SES identity and DKIM keys.
OTP_ROUTE53_HOSTED_ZONE_ID=
# Who gets bounce-rate alerts when a customer's OTP mail bounces too much.
OTP_ALERT_EMAIL=
