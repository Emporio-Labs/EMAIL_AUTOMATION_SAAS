AWS_REGION=ap-south-1
# No AWS keys here: the EC2 instance role provides credentials.
SOURCE_QUEUE_URL=https://sqs.ap-south-1.amazonaws.com/<account-id>/email-jobs
DEAD_LETTER_QUEUE_URL=https://sqs.ap-south-1.amazonaws.com/<account-id>/email-jobs-dlq
SES_FROM_EMAIL=noreply@swayamail.in
SES_CONFIGURATION_SET=email-config
# Must match the API's INTERNAL_KEY
INTERNAL_KEY=replace-with-at-least-32-random-chars
WORKER_CONCURRENCY=10
MAX_RECEIVES=5
